# Shopify Storefront API
# Your store domain (do NOT include https://)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=wxxu4x-f2.myshopify.com

# Your Storefront API access token (from Shopify Admin > Apps > Headless Storefront)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_api_token_here

# Anthropic API — for MUSE AI chat widget
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Resend — for contact form and chat transcript emails
# Get your key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# YouTube Data API v3 — for scripts/youtube-niche-research.mjs
# Console → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth — required for UPLOADING (an API key cannot publish to a channel)
# Google Cloud console → Credentials → OAuth client ID → Desktop app
# Then run: node pipeline/auth.mjs
YOUTUBE_OAUTH_CLIENT_ID=your_oauth_client_id_here
YOUTUBE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
YOUTUBE_OAUTH_REFRESH_TOKEN=run_pipeline_auth_mjs_to_get_this

# Media generation (pipeline/build.mjs)
# Image generation — aistudio.google.com/apikey (YOUTUBE_API_KEY will NOT work, it's restricted)
GEMINI_API_KEY=your_gemini_api_key_here
# Narration — enable "Cloud Text-to-Speech API" in Google Cloud, or reuse GEMINI_API_KEY
GOOGLE_TTS_API_KEY=your_tts_api_key_here
# Optional overrides
# MEDIA_IMAGE_MODEL=gemini-3.1-flash-image
# MEDIA_TTS_VOICE=en-GB-Standard-A
